# AMP India Foundation — Phase 3 AI Chatbot (FastAPI + Gemini + Pinecone)
# Copy to .env and fill in real values. Never commit .env.

APP_NAME=AMP India Foundation AI Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS — comma-separated origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Google Gemini
GEMINI_API_KEY=enter key
# Default chat/RAG model (do not downgrade unless needed)
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional faster model for general-knowledge only (e.g. gemini-2.5-flash-lite)
GEMINI_GENERAL_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
GEMINI_RAG_TEMPERATURE=0.15
GEMINI_GENERAL_TEMPERATURE=0.25
GEMINI_RAG_MAX_OUTPUT_TOKENS=512
GEMINI_GENERAL_MAX_OUTPUT_TOKENS=256

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=aif-chatbot
PINECONE_NAMESPACE=amp-foundation
# Use the region/cloud matching your Pinecone index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG
RAG_TOP_K=10
RAG_SCORE_THRESHOLD=0.28
CHUNK_SIZE=550
CHUNK_OVERLAP=100

# Security / limits
RATE_LIMIT=30/minute
MAX_MESSAGE_LENGTH=2000
MAX_UPLOAD_MB=10
SESSION_TTL_MINUTES=60
# Must match backend CHATBOT_INGEST_TOKEN for CMS → Pinecone sync
ADMIN_INGEST_TOKEN=change-me-to-a-long-random-secret

# Flask CMS/API used for readiness probes (database + CMS)
CMS_API_URL=http://127.0.0.1:5000

# Knowledge base for Pinecone ingest (md / txt / pdf / json)
KNOWLEDGE_DIR=./knowledge
DOCUMENTS_DIR=./documents
