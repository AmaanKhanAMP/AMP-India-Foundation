[MAIN]
init-hook=import pathlib; cwd = pathlib.Path.cwd(); hook = next((c for directory in [cwd, *cwd.parents] for c in (directory / "backend" / "scripts" / "_pylint_path.py", directory / "scripts" / "_pylint_path.py") if c.is_file()), None); exec(hook.read_text(encoding="utf-8"), {"__builtins__": __builtins__}) if hook is not None else None
