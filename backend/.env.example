DB_HOST=localhost
DB_PORT=3306
DB_NAME=aif_cms
DB_USER=root
DB_PASSWORD=

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key

# Comma-separated browser origins allowed to call /api/* (website + CMS).
# Include local Next.js ports AND your Vercel production URLs after deploy.
# Do NOT use * — list exact origins (or use CORS_ORIGIN_REGEXES for previews).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,https://amp-aif.vercel.app

# Optional regex patterns (comma-separated) for Vercel preview/production hosts.
# Example: https://.*\.vercel\.app
# Also list exact production URLs above (website + CMS).
CORS_ORIGIN_REGEXES=https://.*\.vercel\.app

# JWT is sent via Authorization header — leave false unless you switch to cookies
CORS_SUPPORTS_CREDENTIALS=false

# CMS public URL (used in password-reset emails)
CMS_URL=http://localhost:3002

# Optional SMTP — leave blank for local dev (reset URL prints in Flask console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Default admin (used by scripts/seed_admin.py)
ADMIN_EMAIL=admin@ampindiafoundation.org
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=AIF Admin

# Phase-3 chatbot sync — must match chatbot ADMIN_INGEST_TOKEN
CHATBOT_URL=http://127.0.0.1:8000
CHATBOT_INGEST_TOKEN=change-me-to-a-long-random-secret
CHATBOT_SYNC_ENABLED=true
