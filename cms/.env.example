# Local development — Flask on this machine
# CMS is Next.js — use NEXT_PUBLIC_API_URL (not VITE_API_URL).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional: public website origin (for /assets/* previews in CMS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Same value as the public website. Never NEXT_PUBLIC_.
REVALIDATION_SECRET=
# Public website origin used after CMS saves (no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# On Vercel, set:
# NEXT_PUBLIC_API_URL=https://aif-backend-6jwe.onrender.com
# NEXT_PUBLIC_SITE_URL=https://amp-aif.vercel.app
# FRONTEND_ORIGIN=https://amp-aif.vercel.app
# REVALIDATION_SECRET=<same value as the public website>
