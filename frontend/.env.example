# Local development — Flask on this machine
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public frontend origin (not the Render API)
NEXT_PUBLIC_SITE_URL=https://amp-aif.vercel.app

# Server-only. Shared with the CMS. Never use NEXT_PUBLIC_ for this.
REVALIDATION_SECRET=

# Optional Phase 3 chatbot (FastAPI). On Vercel set to the deployed chatbot URL.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000
